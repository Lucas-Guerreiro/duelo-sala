rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras de Segurança para a Coleção de Salas e Respostas
    match /salas/{salaId} {
      // Qualquer um pode ler o estado da sala para poder participar do jogo
      allow read: if true;
      
      // Permitir escrita na sala (o host/professor gerencia o estado da sala)
      allow write: if true;

      // Respostas individuais dos alunos dentro da subcoleção duelo_respostas
      match /duelo_respostas/{alunoId} {
        // Qualquer um pode ler as respostas (Professor lê todas para o painel)
        allow read: if true;
        
        // Um aluno só pode criar ou atualizar seu próprio documento com base no seu ID (alunoId / pid)
        allow create, update: if request.resource.data.pid == alunoId;
        
        // Host/Professor pode limpar as respostas ao iniciar ou encerrar
        allow delete: if true;
      }
    }
  }
}
